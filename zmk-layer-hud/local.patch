     async def _find(self):
         from bleak import BleakScanner
+        if self.address and sys.platform == "darwin":
+            # A keyboard already bonded and connected to the Mac stops advertising, so a scan
+            # never finds it; CoreBluetooth hands it over by its peripheral UUID instead.
+            from Foundation import NSUUID
+            from bleak.backends.corebluetooth.CentralManagerDelegate import CentralManagerDelegate
+            from bleak.backends.device import BLEDevice
+            manager = CentralManagerDelegate()
+            await manager.wait_until_ready()
+            found = manager.central_manager.retrievePeripheralsWithIdentifiers_(
+                [NSUUID.alloc().initWithUUIDString_(self.address)])
+            if found:
+                return BLEDevice(self.address, found[0].name(), (found[0], manager))
